# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual env
.venv/

# Local env vars (never commit)
.env

# IDE
.idea/

# OS
.DS_Store
Thumbs.db

# Local run outputs
# NOTE: we now commit `runs/` so experiment results are reproducible.
# If you want to keep the repo small, consider committing only selected runs
# (or just aggregated CSV/JSON summaries under `figures/`).
# runs/

# Generated plots
# NOTE: we commit plots under figures/ so they render in GitHub README.
# Keep ignoring other stray PNGs in the repo root if any.
!figures/
!figures/**
# If you still want to ignore arbitrary pngs elsewhere, keep the global rule.
# But do NOT ignore figures/*.png.
*.png
!figures/**/*.png
CICIDS2017/
UNSW/
*.csv
